# Example environment file (see docs/VULNERABILITIES.md, "Vulnerability 2"
# for why FLEET_SECRET_KEY has no default and the app refuses to start
# without it).
#
# Copy to .env, fill in real values, and load it with `docker compose`,
# `--env-file`, or your process manager. NEVER commit the real .env file —
# it is already excluded in .gitignore.

FLEET_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
FLEET_ADMIN_USERNAME=admin
FLEET_ADMIN_PASSWORD=change-me-on-first-boot
FLEET_DB_PATH=./fleet.db
